# Copy this file to .env and enter the Wi-Fi module's MAC address for LAN control.
AC_MAC=
# Leave blank to discover the unit by MAC. If needed, use the IPv4 address shown by your router.
AC_IP=
# Optional absolute path to your LAN profile of confirmed controls.
AC_PROFILE_FILE=

# AUX Cloud for devices registered in AC Freedom.
# AC_TRANSPORT=cloud
# AC_CLOUD_REGION=usa
# AC_CLOUD_ENDPOINT=
# AC_CLOUD_EMAIL=
# AC_CLOUD_PASSWORD=
# AC_CLOUD_WRITE=0
# AC_CLOUD_PRODUCT=
# AC_CLOUD_KEYCHAIN_SERVICE=
